{
  "name": "ethercanvas",
  "version": "1.0.0",
  "description": "EtherCanvas - Premium Web3 NFT Studio dApp on Ethereum Sepolia",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "hardhat compile",
